# KRISHIINTEL ENVIRONMENT VARIABLES (EXAMPLE TEMPLATE)

NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
PORT=5000

# Database Connection (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/krishiintel"

# Security & Authentication Secrets
JWT_SECRET=krishiintel_jwt_secret_key_development_only_change_in_production
JWT_EXPIRES_IN=7d

# Third-Party External Integrations (SerpApi)
SERPAPI_KEY=your_serpapi_key_here
SERPAPI_ENABLED=true
SERPAPI_TIMEOUT_MS=10000
SERPAPI_CACHE_TTL_SECONDS=1800
